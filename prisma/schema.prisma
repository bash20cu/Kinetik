generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionLogStatus {
  planned
  in_progress
  completed
  discarded
}

enum SessionExerciseStatus {
  pending
  in_progress
  completed
  skipped
}

enum AlertType {
  info
  warning
  success
  error
}

enum RoutineTemplateStatus {
  active
  archived
}

enum Role {
  admin
  user
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  passwordHash  String            @default("") @map("password_hash")
  role          Role              @default(user)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      UserSession[]
  sessionLogs   SessionLog[]
  templates     RoutineTemplate[]
  alerts        InAppAlert[]
  planImports   PlanImport[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model ExerciseLibrary {
  id            String            @id @default(uuid())
  name          String            @unique
  groupName     String            @map("group_name")
  defaultSets   Int?              @map("default_sets")
  defaultReps   String?           @map("default_reps")
  defaultRest   Int?              @map("default_rest")
  notes         String?
  variant       String?
  sessionExercises SessionExercise[]
  templateExercises RoutineTemplateExercise[]

  @@map("exercise_library")
}

model SessionLog {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  sessionDate      DateTime           @map("session_date") @db.Date
  durationSeconds  Int?               @map("duration_seconds")
  status           SessionLogStatus
  generalNotes     String?            @map("general_notes")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises        SessionExercise[]

  @@index([userId, sessionDate])
  @@map("session_logs")
}

model SessionExercise {
  id            String                @id @default(uuid())
  sessionId     String                @map("session_id")
  exerciseId    String?               @map("exercise_id")
  customName    String?               @map("custom_name")
  groupName     String                @map("group_name")
  orderIndex    Int                   @map("order_index")
  plannedSets   Int?                  @map("planned_sets")
  plannedReps   String?               @map("planned_reps")
  actualSets    Int?                  @map("actual_sets")
  reps          String?
  weight        String?
  status        SessionExerciseStatus
  note          String?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  session       SessionLog            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise      ExerciseLibrary?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@map("session_exercises")
}

model RoutineTemplate {
  id          String                    @id @default(uuid())
  userId      String                    @map("user_id")
  name        String
  status      RoutineTemplateStatus
  isFavorite  Boolean                   @default(false) @map("is_favorite")
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   RoutineTemplateExercise[]

  @@map("routine_templates")
}

model RoutineTemplateExercise {
  id            String          @id @default(uuid())
  templateId    String          @map("template_id")
  exerciseId    String?         @map("exercise_id")
  customName    String?         @map("custom_name")
  groupName     String          @map("group_name")
  orderIndex    Int             @map("order_index")
  plannedSets   Int?            @map("planned_sets")
  plannedReps   String?         @map("planned_reps")
  notes         String?
  variant       String?
  template      RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise      ExerciseLibrary? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@unique([templateId, orderIndex])
  @@map("routine_template_exercises")
}

model InAppAlert {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      AlertType
  title     String
  body      String
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("in_app_alerts")
}

model PlanImport {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  fileName     String           @map("file_name")
  status       PlanImportStatus
  errorSummary String?          @map("error_summary")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plan_imports")
}

enum PlanImportStatus {
  processing
  success
  failed
}
